# Copiați în .env și completați. NU puneți secrete reale în git.
NODE_ENV=development
PORT=8080
PUBLIC_API_URL=http://localhost:8080
APP_URL=http://localhost:3000

DATABASE_URL=postgres://postgres:postgres@localhost:5432/pbn
REDIS_URL=redis://localhost:6379
QUEUE_PREFIX=pbn

# Dev: HS256. Producție: AUTH_JWKS_URL (+ AUTH_ISSUER / AUTH_AUDIENCE)
AUTH_JWT_SECRET=change-me-dev-secret-at-least-32-characters
# AUTH_JWKS_URL=https://<idp>/.well-known/jwks.json

# Stocare: local (dev) | s3 (producție / MinIO)
STORAGE_DRIVER=local
# Cale ABSOLUTĂ comună cu worker-ul Python când STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=/tmp/pbn-storage
S3_BUCKET_SOURCES=pbn-dev-sources
S3_BUCKET_ARTIFACTS=pbn-dev-artifacts
S3_REGION=eu-central-1

# Chei: local (dev, generate în .data/keys) | kms (producție)
KEY_PROVIDER=local
# KMS_TOKEN_KEY_ID=arn:aws:kms:...:key/...   (simetrică, SYMMETRIC_DEFAULT)
# KMS_UPLOAD_KEY_ID=arn:aws:kms:...:key/...  (asimetrică RSA_3072, ENCRYPT_DECRYPT)

# Google Cloud Console → OAuth client „Web application"; redirect URI:
#   ${PUBLIC_API_URL}/v1/integrations/google/callback
# API de activat: Google Photos Picker API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
# Teme importate zilnic de worker-ul de ingestie:
CATALOG_THEMES=[{"theme":"lavender field","category":"flori"},{"theme":"alpine lake","category":"peisaje"}]

MAX_UPLOAD_BYTES=52428800
ENGINE_VERSION=0.1.0
